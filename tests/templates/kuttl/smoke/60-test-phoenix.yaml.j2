{# Phoenix is only shipped in the HBase 2.x images (it does not support HBase 3.x yet) #}
{% set with_phoenix = test_scenario['values']['hbase'].split(',')[0].startswith('2.') %}
{% if with_phoenix %}
---
apiVersion: kuttl.dev/v1beta1
kind: TestStep
commands:
  - script: kubectl cp --namespace=$NAMESPACE -c hbase ./test_phoenix.sh test-hbase-restserver-default-0:/tmp
{% endif %}
